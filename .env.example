# Backend
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cti-platform

# Frontend
API_URL=http://localhost:3000

# Docker (hostnames internos de la red Docker)
MONGODB_URI_DOCKER=mongodb://mongo:27017/cti-platform
API_URL_DOCKER=http://backend:3000
BACKEND_PUBLIC_URL=http://localhost:3000

# Auth (JWT + Google OAuth2)
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
