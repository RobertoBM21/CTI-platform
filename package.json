{
    "name": "cti-platform-workspace",
    "version": "0.0.1",
    "description": "CTI Platform workspace",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
    "scripts": {
        "build": "pnpm -r --if-present build",
        "format": "pnpm -r --if-present format",
        "start": "pnpm -r --parallel --if-present start",
        "start:dev": "pnpm -r --parallel --if-present start:dev",
        "start:debug": "pnpm -r --parallel --if-present start:debug",
        "start:prod": "pnpm -r --parallel --if-present start:prod",
        "lint": "pnpm -r --if-present lint",
        "lint:fix": "pnpm -r --if-present lint:fix",
        "test": "pnpm -r --if-present test",
        "test:watch": "pnpm -r --parallel --if-present test:watch",
        "test:cov": "pnpm -r --if-present test:cov",
        "test:debug": "pnpm -r --parallel --if-present test:debug",
        "test:e2e": "pnpm -r --if-present test:e2e",
        "backend:build": "pnpm --filter @cti-platform/backend run build",
        "backend:format": "pnpm --filter @cti-platform/backend run format",
        "backend:start": "pnpm --filter @cti-platform/backend run start",
        "backend:start:dev": "pnpm --filter @cti-platform/backend run start:dev",
        "backend:start:debug": "pnpm --filter @cti-platform/backend run start:debug",
        "backend:start:prod": "pnpm --filter @cti-platform/backend run start:prod",
        "backend:lint": "pnpm --filter @cti-platform/backend run lint",
        "backend:lint:fix": "pnpm --filter @cti-platform/backend run lint:fix",
        "backend:test": "pnpm --filter @cti-platform/backend run test",
        "backend:test:watch": "pnpm --filter @cti-platform/backend run test:watch",
        "backend:test:cov": "pnpm --filter @cti-platform/backend run test:cov",
        "backend:test:debug": "pnpm --filter @cti-platform/backend run test:debug",
        "backend:test:e2e": "pnpm --filter @cti-platform/backend run test:e2e",
        "frontend:dev": "pnpm --filter @cti-platform/frontend run dev",
        "frontend:build": "pnpm --filter @cti-platform/frontend run build",
        "frontend:start": "pnpm --filter @cti-platform/frontend run start",
        "frontend:lint": "pnpm --filter @cti-platform/frontend run lint",
        "frontend:lint:fix": "pnpm --filter @cti-platform/frontend run lint:fix",
        "frontend:format": "pnpm --filter @cti-platform/frontend run format",
        "frontend:test": "pnpm --filter @cti-platform/frontend run test",
        "frontend:test:watch": "pnpm --filter @cti-platform/frontend run test:watch",
        "frontend:test:cov": "pnpm --filter @cti-platform/frontend run test:cov",
        "frontend:test:e2e": "pnpm --filter @cti-platform/frontend run test:e2e"
    }
}
